---
const builtAt = new Date();
const builtAtLabel = new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(builtAt);
---

<footer>
  <p>Updated <time datetime={builtAt.toISOString()}>{builtAtLabel}</time></p>
  <a href="https://github.com/fubits1/coolify-service-list-unofficial" translate="no">
    fubits1/coolify-service-list-unofficial
  </a>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-inline-size: 80rem;
    margin-inline: auto;
    padding: 1.5rem;
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.8125rem;

    & p {
      margin: 0;
    }

    & a {
      color: inherit;
      text-underline-offset: 3px;
      transition-property: color;
      transition-duration: var(--transition-duration);

      &:hover {
        color: var(--color-text);
      }
    }
  }
</style>
